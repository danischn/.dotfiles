{
    "layer": "top",
    "modules-center": ["sway/workspaces"],
    "modules-right": ["custom/pomoschni", "pulseaudio", "network", "bluetooth", "battery", "clock"],

    "network": {
        "interface": "wlp2s0",
        "on-click": "nm-connection-editor",
        "format-wifi": "",
        "format-disconnected": "󱛅", 
        "tooltip-format-wifi": "{essid}",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "bluetooth": {
        "format": "",
        "on-click": "blueberry",
        "tooltip-format": "Bluetooth"
    },

    "battery": {
        "format": "{icon}",
        "format-icons": {
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "tooltip-format": "{capacity}%",
        "interval": 5
    },

    "clock": {
        "format": "{:%H.%M}",
        "tooltip": true,
        "tooltip-format": "Date: {:%d %b \nWeek: %g}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "on-click": "toggle-white-noice",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        }
    },

    "custom/pomoschni": {
        "format": "{}",
        "exec": "/home/schnei/Projects/pomoschni/pomoschni.py"
    }
}
